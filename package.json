{
  "name": "tmi-revision",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --configLoader=runner --base=/TMI-Revision/",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && vite build --configLoader=runner && npm run check:bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/vite": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
